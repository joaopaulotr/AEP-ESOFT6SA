MONGO_URI=mongodb://localhost:27017
MONGO_DB=app_db
OPENAI_API_KEY=
# LLM_PROVIDER: openai (usa a API real, exige OPENAI_API_KEY) ou fake (offline, respostas simuladas)
LLM_PROVIDER=openai
# LLM_MODEL: modelo de chat usado quando LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Tempo máximo (segundos) de cada chamada ao provedor de IA
LLM_TIMEOUT_SECONDS=20
# SPEECH_MODEL: modelo de voz (TTS). O tom da persona só é aplicado nos gpt-4o*-tts
SPEECH_MODEL=gpt-4o-mini-tts
# Tamanho máximo do áudio enviado para transcrição (bytes; 26214400 = 25 MB)
MAX_AUDIO_BYTES=26214400
# Tamanho máximo do questionário enviado para importar (bytes; 2097152 = 2 MB)
MAX_UPLOAD_BYTES=2097152
# FRONTEND_URL: endereço público do front; vira o link do convite e do QR Code
FRONTEND_URL=http://localhost:5173
# Preços de referência (USD) para ESTIMAR o custo por entrevista no painel (não é a fatura)
PRICE_LLM_INPUT_PER_1M=0.15
PRICE_LLM_OUTPUT_PER_1M=0.60
PRICE_STT_PER_MINUTE=0.006
PRICE_TTS_PER_1M_CHARS=15.0
